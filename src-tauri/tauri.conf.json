{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scanshark",
  "version": "0.3.0",
  "identifier": "dev.scanshark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScanShark",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Leafyhead Technologies",
    "copyright": "Copyright (c) 2026 Leafyhead Technologies",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Disk-space treemap",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
